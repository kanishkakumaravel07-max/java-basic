swapping
class Main {
    public static void main(String[] args) {
        int a = 30;
        int b = 20;
        int temp =  a;
         a = b;
         b = temp;
            System.out.println(a+ " " +b);
    }
}

without using temp

class Main {
    public static void main(String[] args) {
        int a = 10;
        int b = 20;
        a=a+b;//30
        b=a-b;//10
        a=a-b;//20
            System.out.println(a+ " " +b);
    }
}

