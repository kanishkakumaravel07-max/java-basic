// insertion using array
import java.util.*;
class Main {
    public static void main(String[] args) {
        Scanner s = new Scanner(System.in);
        int size = s.nextInt();
        int arr[] = new int[size+1];
        for(int i=0;i<size;i++){
            arr[i] = s.nextInt();
        }
        int pos=s.nextInt();
        if(pos<0||pos>size+1){
            System.out.println("Invalid");
        } else {
            int element = s.nextInt();
            for(int i=0;i>pos;i--){
                arr[i] = arr[i-1];
            }
            arr[pos]=element;
        }
        for(int x:arr){
            System.out.print(x+" ");
        }
      
    }
  }



